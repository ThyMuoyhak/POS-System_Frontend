# Copy this file to `.env` and adjust it. `.env` is git-ignored, this template is not.

# Backend url used by the POS UI (no trailing slash)
REACT_APP_API_BASE=http://127.0.0.1:8000

# Set to "true" to show the manual "mark as paid" test button in the checkout
# screen. Keep it "false" in production: that button confirms a payment without
# the gateway. When the variable is missing the code falls back to showing it.
REACT_APP_ALLOW_MANUAL_CONFIRM=false
